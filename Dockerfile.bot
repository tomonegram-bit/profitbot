FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY bot/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY bot/ .

# Build the application
RUN npm run build

# Create logs directory
RUN mkdir -p logs

# Health check (bot doesn't have HTTP endpoint, so we check if process is running)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD pgrep -f "node.*bot" || exit 1

# Start the application
CMD ["npm", "start"]