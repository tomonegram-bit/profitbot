# ==========================================
# TRON LOCK SYSTEM - ENVIRONMENT VARIABLES
# ==========================================

# ===== NETWORK CONFIGURATION =====
# Options: nile, mainnet
TRON_NETWORK=nile
TRON_FULLNODE=https://nile.trongrid.io
TRON_SOLIDITYNODE=https://nile.trongrid.io
TRON_EVENTSERVER=https://nile.trongrid.io

# ===== TRONGRID API KEY =====
# Get from: https://www.trongrid.io/dashboard
TRONGRID_API_KEY=your_trongrid_api_key_here

# ===== CONTRACT ADDRESSES =====
# Testnet MockUSDT (deployed by admin)
USDT_CONTRACT_ADDRESS=TXYZ1234567890abcdef

# ===== WALLET ADDRESSES =====
ADMIN_COLD_WALLET=TXYZ1234567890abcdef
ADMIN_FEE_WALLET=TXYZ1234567890abcdef
OPS_TRX_WALLET=TXYZ1234567890abcdef

# ===== WALLET KEYS (ENCRYPTED) =====
# Private keys for OPS_TRX_WALLET (encrypted)
OPS_TRX_WALLET_PRIVATE_KEY_ENCRYPTED=your_encrypted_private_key_here

# ===== DATABASE CONFIGURATION =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/tron_lock_db
REDIS_URL=redis://localhost:6379

# ===== TELEGRAM BOT =====
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username

# ===== SECURITY =====
# Master encryption key for private keys
MASTER_ENCRYPTION_KEY=your_32_character_master_key_here

# Admin dashboard JWT secret
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# 2FA Secret (base32 encoded)
TOTP_SERVICE_NAME=TRON Lock System

# ===== APPLICATION SETTINGS =====
NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
BOT_PORT=3002

# ===== BLOCKCHAIN SETTINGS =====
REQUIRED_CONFIRMATIONS=20
MIN_DEPOSIT_USDT=101
FIXED_FEE_USDT=1
LOCK_DURATION_DAYS=30
REWARD_BPS=1500
REQUIRED_REFERRALS=1

# ===== OPS WALLET SETTINGS =====
OPS_TRX_MIN_BALANCE=1000
TRX_TOPUP_AMOUNT=15

# ===== LOGGING =====
LOG_LEVEL=info

# ==========================================
# MAINNET CONFIGURATION (EXAMPLES)
# ==========================================
# TRON_NETWORK=mainnet
# TRON_FULLNODE=https://api.trongrid.io
# TRON_SOLIDITYNODE=https://api.trongrid.io
# TRON_EVENTSERVER=https://api.trongrid.io
# USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t